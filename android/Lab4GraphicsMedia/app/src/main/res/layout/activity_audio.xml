<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="程序6  MediaPlayer音频播放"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#1565C0" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="音频源：res/raw/xiaoge.mp3"
        android:textSize="12sp"
        android:textColor="#666666" />

    <TextView
        android:id="@+id/tvAudioState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="14sp"
        android:textColor="#333333" />

    <TextView
        android:id="@+id/tvAudioProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="播放进度：00:00 / 00:00"
        android:textSize="14sp"
        android:textColor="#1565C0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAudioPlay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:text="播放" />

        <Button
            android:id="@+id/btnAudioPause"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:text="暂停" />

        <Button
            android:id="@+id/btnAudioStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:text="停止" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="说明：MediaPlayer.create() 加载音频后，start() 播放、pause() 暂停、stop() 停止（停止后需 prepare() 才能重新播放），Activity 销毁时调用 release() 释放资源。"
        android:textSize="12sp"
        android:textColor="#888888" />

</LinearLayout>
