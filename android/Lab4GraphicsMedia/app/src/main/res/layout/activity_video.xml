<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="程序7  MediaPlayer + SurfaceView 视频播放"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#1565C0" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="视频源：res/raw/video.mp4（实验素材“实验7”目录）"
        android:textSize="12sp"
        android:textColor="#666666" />

    <SurfaceView
        android:id="@+id/svVideo"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tvVideoState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="14sp"
        android:textColor="#333333" />

    <TextView
        android:id="@+id/tvVideoProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="播放位置：00:00 / 00:00"
        android:textSize="14sp"
        android:textColor="#1565C0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnVideoPlay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:text="播放" />

        <Button
            android:id="@+id/btnVideoPause"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:text="暂停" />

        <Button
            android:id="@+id/btnVideoStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:text="停止" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="说明：SurfaceView 提供显示表面，SurfaceHolder.Callback 的 surfaceCreated() 中调用 MediaPlayer.setDisplay(holder) 把视频画面输出到 SurfaceView；播放、暂停、停止由 MediaPlayer 控制，销毁时 release() 释放资源。"
        android:textSize="12sp"
        android:textColor="#888888" />

</LinearLayout>
